---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const meResp = await fetch(new URL('/api/auth/me', Astro.request.url), { headers: Astro.request.headers });
if (meResp.status === 401) return Astro.redirect('/signin');
const { user } = await meResp.json();
if (user.role !== 'admin') return Astro.redirect('/inbox');
---

<AdminLayout title="Add Domain">
  <div class="mx-auto max-w-lg px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900">Add Domain</h1>
    <p class="mt-1 text-sm text-gray-500">Enter a domain name you own. You will need to update DNS records after setup.</p>

    <form id="domainForm" class="mt-6 space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Domain Name</label>
        <input type="text" id="name" name="name" required placeholder="example.com" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
      </div>
      <p id="error" class="hidden text-sm text-red-600"></p>
      <div class="flex items-center gap-4">
        <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Add Domain</button>
        <a href="/admin/domains" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
      </div>
    </form>
  </div>

  <script>
    const form = document.getElementById('domainForm') as HTMLFormElement;
    const errorEl = document.getElementById('error') as HTMLParagraphElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.classList.add('hidden');
      const name = (document.getElementById('name') as HTMLInputElement).value;
      const res = await fetch('/api/admin/domains', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      const data = await res.json();
      if (!res.ok) { errorEl.textContent = data.error || 'Failed to add domain'; errorEl.classList.remove('hidden'); return; }
      window.location.href = `/admin/domains/${data.id}`;
    });
  </script>
</AdminLayout>
