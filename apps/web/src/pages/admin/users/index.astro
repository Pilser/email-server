---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const meResp = await fetch(new URL('/api/auth/me', Astro.request.url), { headers: Astro.request.headers });
if (meResp.status === 401) return Astro.redirect('/signin');
const { user: me } = await meResp.json();
if (me.role !== 'admin') return Astro.redirect('/inbox');

const resp = await fetch(new URL('/api/admin/users', Astro.request.url), { headers: Astro.request.headers });
const { users } = await resp.json();
---

<AdminLayout title="Users">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">Users</h1>
    </div>
    <div class="mt-6 overflow-hidden rounded-lg border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Email</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Role</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Mailboxes</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          {users.length === 0 && (
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No users found.</td>
            </tr>
          )}
          {users.map((u: any) => (
            <tr key={u.id} class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">{u.name}</td>
              <td class="px-6 py-4 text-sm text-gray-700">{u.email}</td>
              <td class="px-6 py-4 text-sm">
                {u.role === 'admin' ? (
                  <span class="rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-medium text-purple-800">admin</span>
                ) : (
                  <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">user</span>
                )}
              </td>
              <td class="px-6 py-4 text-sm text-gray-500">{u.mailboxCount}</td>
              <td class="px-6 py-4 text-sm">
                {u.id !== me.id && (
                  <button
                    class="delete-btn text-red-600 hover:text-red-800 hover:underline"
                    data-user-id={u.id}
                    data-user-name={u.name}
                  >
                    Delete
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.userId;
        const userName = (btn as HTMLElement).dataset.userName;
        if (!confirm(`Delete user "${userName}" and all their data? This cannot be undone.`)) return;
        const res = await fetch(`/api/admin/users/${userId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) { alert(data.error || 'Failed to delete user'); return; }
        window.location.reload();
      });
    });
  </script>
</AdminLayout>
