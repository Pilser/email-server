---
export interface Props {
  title?: string;
}

const { title = 'Admin - Email Server' } = Astro.props;
import '../styles/globals.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <div class="flex items-center gap-6">
          <a href="/admin" class="text-lg font-bold text-gray-900">Admin</a>
          <a href="/admin/domains" class="text-sm font-medium text-gray-600 hover:text-gray-900">Domains</a>
          <a href="/admin/users" class="text-sm font-medium text-gray-600 hover:text-gray-900">Users</a>
        </div>
        <div class="flex items-center gap-4">
          <a href="/inbox" class="text-sm text-gray-500 hover:text-gray-700">Back to Inbox</a>
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>
